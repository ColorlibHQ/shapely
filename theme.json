{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#745cf9",
					"name": "Primary"
				},
				{
					"slug": "primary-hover",
					"color": "#5234f9",
					"name": "Primary hover"
				},
				{
					"slug": "heading",
					"color": "#0e1015",
					"name": "Heading"
				},
				{
					"slug": "body",
					"color": "#8c979e",
					"name": "Body text"
				},
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "dark",
					"color": "#0e1015",
					"name": "Dark"
				},
				{
					"slug": "light",
					"color": "#f7f8f9",
					"name": "Light"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "raleway",
					"name": "Raleway",
					"fontFamily": "Raleway, 'Helvetica Neue', Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "12px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "14px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "18px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "25px",
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "45px",
					"name": "Huge"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		},
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1140px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--raleway)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.71"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontWeight": "400"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontSize": "12px",
					"fontWeight": "700",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		}
	}
}
